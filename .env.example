# Copy to .env.local for local development. Never commit real credentials.
# Demo mode is accepted only outside NODE_ENV=production.
ADA_DEMO_MODE=true
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 1 CRM handshake only. Keep disabled until the coordinated integration rollout.
# Per-connection credentials are server-only; only hashes are stored in the database.
ADA_CRM_INTEGRATION_ENABLED=false
# Keep false until both systems pass the coordinated rollout checks.
ADA_CRM_BOOKING_ENABLED=false

# Server-side only. Do not use NEXT_PUBLIC_ prefixes for secret keys.
OPENAI_API_KEY=
# V1 intentionally pins gpt-5.6-sol and gpt-transcribe in the server adapter.

# capture is mandatory for local/preview environments by default.
EMAIL_MODE=capture
EMAIL_FROM=ADA Calendar <calendar@your-verified-domain.example>
EMAIL_TEST_ALLOWLIST=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Bootstrap command inputs, populated by you before live setup.
OWNER_EMAIL=
KYLE_EMAIL=
WILLIAM_EMAIL=

# Supabase worker HTTP authentication; generate a strong independent secret.
WORKER_SECRET=
